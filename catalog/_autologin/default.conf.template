# Signs the owner in to ${UPSTREAM}, so the app never asks for its key.
# Port 80 (published) adds the key, so it only answers the owner's browser. Port 8081 adds nothing: the
# dashboard probes it, and other containers on mos-net still have to present the key themselves.
include /etc/nginx/mos-resolver.conf;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Any website the owner visits can send requests to localhost; these must not ride on the added key.
map $http_origin $bad_origin {
    default 1;
    '' 0;
    'http://localhost:${APP_PORT}' 0;
    'http://127.0.0.1:${APP_PORT}' 0;
}

proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_buffering off;
proxy_read_timeout 3600s;
client_max_body_size 0;

server {
    listen 80;
    include /etc/nginx/mos-allow.conf;
    if ($host !~ ^(localhost|127\.0\.0\.1)$) { return 403; }
    if ($bad_origin) { return 403; }

    location / {
        set $app ${UPSTREAM};
        proxy_pass http://$app;
        # nginx drops inherited proxy_set_header once a block sets its own, so the shared ones are repeated here.
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization "${AUTH_HEADER}";
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '${HEAD_SNIPPET}</head>';
    }
}

server {
    listen 8081;

    location / {
        set $app ${UPSTREAM};
        proxy_pass http://$app;
    }
}
